[Desktop Entry]
Type=Application
Name=rlogg
GenericName=Log file viewer
Comment=Fast viewer for very large log files
Exec=rlogg %f
Icon=rlogg
Terminal=false
Categories=Utility;TextTools;
MimeType=text/plain;text/x-log;application/gzip;application/x-bzip2;application/x-xz;application/zip;application/x-7z-compressed;application/x-tar;
Keywords=log;viewer;tail;grep;klogg;
StartupWMClass=rlogg
